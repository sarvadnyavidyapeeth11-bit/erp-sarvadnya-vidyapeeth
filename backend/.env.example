SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Used for Admin/Admission/Fee staff Auth users. Minimum 8 characters.
ERP_STAFF_AUTH_PASSWORD=change-this-before-running

# Students are synced from the students table by default.
# Their Auth email becomes SCHOLAR_NO@students.sarvadnya.erp and password becomes SCHOLAR_NO.

# Optional extra comma-separated student IDs. Each becomes STUDENT_ID@students.sarvadnya.erp.
# ERP_STUDENT_IDS=262701,262702

# Set false only when you do not want to read students from Supabase.
# ERP_SYNC_STUDENTS_FROM_DB=true
