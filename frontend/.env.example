# Sarvadnya Vidyapeeth ERP - Supabase Credentials
# 1. Create a free project at https://supabase.com
# 2. Go to Project Settings -> API
# 3. Copy Project URL and Anon Public Key below:

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here
VITE_ERP_BACKEND_URL=http://localhost:4000

# Production: keep this false or unset. Set true only for local demo testing without Supabase Auth users.
# VITE_ALLOW_LOCAL_AUTH_FALLBACK=false

# Optional local UI mirror for default staff accounts.
VITE_DEFAULT_STAFF_PASSWORD=ChangeThisStaffPassword123

# Supavisor Connection Pooler (Port 6543 for Direct Node.js / Express DB Connections):
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-ID].supabase.co:6543/postgres?pgbouncer=true
